### Vulcanoplot of TLS-LMM

```{r lmm_vulcano, warning = F, fig.height=5, fig.width=5}
# Categorize Results based on P-value & FDR for plotting
fc_threshold = 1

lmm_results$Color <- "ns"
lmm_results$Color[lmm_results$`Pr(>|t|)` < 0.05] <- "p < 0.05"
lmm_results$Color[lmm_results$FDR < 0.05] <- "FDR < 0.05"
lmm_results$Color[lmm_results$FDR < 0.001] <- "FDR < 0.001"
#lmm_results$Color[abs(lmm_results$Estimate) < fc_threshold] <- paste("NS or FC < ", fc_threshold)
lmm_results$Color <- factor(lmm_results$Color, levels = c("ns", "p < 0.05", "FDR < 0.05"))

for(c in unique(lmm_results$Contrast) ) {
  print(c)
  lmm_results_slice = lmm_results[lmm_results$Contrast == c,]

  # pick top genes for either side of volcano to label
  # order genes for convenience:
  lmm_results_slice$invert_P <- (-log10(lmm_results_slice$`Pr(>|t|)`)) * sign(lmm_results_slice$Estimate)
  top_g <- c()

  lmm_results_slice <- lmm_results_slice[, -1*ncol(lmm_results_slice)] # remove invert_P from matrix
  
  # Flip Contrast
  contrast_lab <- as.character(lmm_results_slice$Contrast)
  contrast_lab <- strsplit(contrast_lab, "-")[[1]]
  contrast_lab <- paste(contrast_lab[2], "-", contrast_lab[1])
  
  # Graph results
  print(ggplot(lmm_results_slice,
               aes(x = Estimate, y = -log10(`Pr(>|t|)`),
                   color = Color, label = Gene)) +
          geom_vline(xintercept = c(fc_threshold, -fc_threshold), lty = "dashed", color = "gray") +
          geom_hline(yintercept = -log10(0.05), lty = "dashed", color = "gray") +
          geom_point() +
          ggtitle("TLS") +
          scale_x_continuous(breaks = c(-1.5, -1, -0.5, 0, 0.5, 1, 1.5), limits = c(-1.5, 1.5)) +
          labs(
            x = "PM vs GC: log2 (FC)",
               y = "-log10 (p-value)")+
          scale_color_manual(values = c(`FDR < 0.001` = "dodgerblue",
                                        `FDR < 0.05` = "lightblue",
                                        `p < 0.05` = "orange2",
                                        `ns` = "gray"),
                             guide = guide_legend(override.aes = list(size = 5))) +
          scale_y_continuous(expand = expansion(mult = c(0,0.05))) +
          geom_text_repel(data = subset(lmm_results_slice,  FDR < 0.05 | abs(lmm_results_slice$Estimate) > fc_threshold),
                          point.padding = 0.15, color = "black",size=5,
                          min.segment.length = .1, box.padding = .2, lwd = 2,
                          max.overlaps = 50) +
          theme_bw(base_size = 16) +
          theme(legend.position = "bottom", plot.title = element_text(hjust = 0.5), legend.title = element_blank())#+
          #facet_wrap(~Subset, scales = "free_y")
        )
}


