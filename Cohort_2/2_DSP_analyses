#select maturity genes
maturity_genes <- c("MS4A1", "CD3E", "FCER2", "CR2", "CXCL13", "BCL6") #"CD180", "GATA2", "EP300","PTCRA"

#are these in the panel?
in_panel <- subset(genes, genes %in% maturity_genes)
setdiff(maturity_genes, in_panel)

#create a df with custom aoi names
mature_data <- log2(assayDataElement(target_Data[in_panel,active_aois_TLS], elt = "q_norm"))
order <- sort(colnames(mature_data ))
mature_data  <- mature_data [, order] #reorder columns alphabetically
colnames(mature_data ) <- ann$name[which(ann$region == "TLS")]
ann_TLS <- subset(ann, region == "TLS")
rownames(ann_TLS) <- ann_TLS$name

```

```{r fig.width=15, fig.height=10, warning = F}
#subset for cell whose means > 0.01
means <- colMeans(props_TLS_all[,-1])
means <- names(means[which(means > 0.03)])

df <- props_TLS_all %>% 
  column_to_rownames("name") %>% 
  select(means) %>% t

maturity_matrix <- rbind(mature_data, df)

mature_TLS_hm<- pheatmap(maturity_matrix ,
         scale = "row", # additional normalization by row 
         angle_col = 90,
         main = "TLS maturity", 
         cutree_rows = 2, cutree_cols = 2,
         show_rownames = T, show_colnames = T,
         clustering_method = "complete",
         clustering_distance_cols = "correlation",
         clustering_distance_rows = "correlation",
         breaks = seq(-3, 3, 0.05),
         color = colorRampPalette(c("#003399", "#FFFFE6", "#CC0000"))(120),
         annotation_colors = c(ann_c_TLS, ann_c_pt, ann_c_tissue),
         cellheight = 15, cellwidth = 15,
         labels_col = ann$name[which(ann$region == "TLS")],
         annotation_col = ann_TLS[, c("tissue", "patient", "region")])

clusters <- cutree(mature_TLS_hm$tree_col, k = 2)
table(clusters)
ann_TLS$maturity <- clusters
ann_TLS$maturity[which(ann_TLS$maturity == 1)] <- "mature"
ann_TLS$maturity[which(ann_TLS$maturity == 2)] <- "non-mature"

#add maturity to target_Data
pData(target_Data)$maturity <- NA
pData(target_Data)$maturity[which(pData(target_Data)$region == "TLS")] <- ann_TLS$maturity
ann$maturity <- pData(target_Data)$maturity

mature_TLS_hm<- pheatmap(maturity_matrix ,
         scale = "row", # additional normalization by row 
         angle_col = 90,
