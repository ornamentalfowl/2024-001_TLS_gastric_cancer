# 6. Batch correction

```{r fig.width=20, fig.height=5}
#This section uses limma for batch correction

# create a log2 transform of the data for batch correction
assayDataElement(object = target_Data, elt = "log_q") <-
  assayDataApply(target_Data, 2, FUN = log, base = 2, elt = "q_norm")

ann <- pData(target_Data)[,1:12]
exprs <- assayDataElement(target_Data , elt = "log_q")
batch <- ann$DSP

exprs_correction <- limma::removeBatchEffect(exprs, batch)

par(mfrow=c(2,1))
boxplot(as.data.frame(exprs),main="Original")
boxplot(as.data.frame(exprs_correction),main="Batch corrected")

assayDataElement(object = target_Data, elt = "log_limma") <- exprs_correction
```


