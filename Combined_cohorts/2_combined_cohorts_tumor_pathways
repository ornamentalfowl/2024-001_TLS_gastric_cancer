# Expression of genes within significant pathways
Here we use the log_limma data, which has undergone batch correction by limma. FDR < 0.05
```{r}
#Gene lists:
#immune_panels, tumor_signalling, msigdbr_list_met, msigdbr_list_kegg , msigdbr_list_wiki , msigdbr_list_onco
#r_ssgsea_test_im, r_ssgsea_test_onco, r_ssgsea_test_kegg, r_ssgsea_test_wiki

wrangle <- function(x) {
  
  as.data.frame(x) %>% 
  rownames_to_column("genes") %>%
  pivot_longer(cols = 2:ncol(.), names_to = "aois", values_to = "exprs") %>%
  left_join(pData(target_Data) %>% select("DSP", "patient", "region", "tissue", "mature_pt", "aois"), by = "aois") %>%
  mutate(mature_pt = factor(mature_pt, levels = c("non-mature",  "mature")))

  }
```

## Immune panels

T cell checkpoints - limited selection
```{r fig.height = 5, fig.width=10}
goi <- c("CMTM4", "PDCD1", "ICOSLG", "PVRIG")

stat_test <- assayDataElement(target_Data, elt = "log_limma")[goi,] %>% 
  wrangle %>%
  group_by(genes) %>%
  wilcox_test(exprs ~ mature_pt) %>% 
  mutate(FDR = p.adjust(.$p, method = "fdr")) %>% 
  add_significance(p.col = "FDR", output.col = "p.signif") %>% print

stat_test[stat_test == "****"] <- "***" #adjust cutoff

assayDataElement(target_Data, elt = "log_limma")[goi,] %>% 
  wrangle %>%
  filter(genes %in% stat_test$genes[which(stat_test$FDR < 0.05)]) %>%
  ggplot(aes(x = mature_pt, y = exprs)) +
  geom_boxplot(aes(fill = mature_pt), width = 0.8) +
  theme(aspect.ratio = 1.5, 
        legend.title = element_blank()) +
  scale_fill_manual(values = c("#CBB9F9", "#9066FA" )) +
  facet_wrap(~genes, ncol = 4) +
  stat_pvalue_manual(stat_test %>%
                     add_xy_position, 
                     hide.ns = T, 
                     label = "p.signif", 
                     tip.length = 0) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.1))) +
  labs(x = "", y = "expression")

```

